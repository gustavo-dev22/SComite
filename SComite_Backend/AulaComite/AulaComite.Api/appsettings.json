{
    "ConnectionStrings": {
        // En producción la cadena de conexión se inyecta vía variable de entorno:
        //   ConnectionStrings__DefaultConnection
        "DefaultConnection": "YOUR_DATABASE_CONNECTION_STRING"
    },
    "SasiSettings": {
        "BaseUrl": "https://localhost:44337/SASI/api/",
        "SistemaId": 7
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:4200",
            "http://127.0.0.1:4200",
            "http://localhost:4202"
        ]
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/aula_comite-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "Cloudinary": {
        "CloudName": "aerof1gd",
        // Inyectar vía variables de entorno: Cloudinary__ApiKey y Cloudinary__ApiSecret
        "ApiKey": "YOUR_CLOUDINARY_API_KEY_HERE",
        "ApiSecret": "YOUR_CLOUDINARY_API_SECRET_HERE"
    },
    "AllowedHosts": "*"
}
